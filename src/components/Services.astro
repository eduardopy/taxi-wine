---
import { contact, getContent, withBase, type Locale } from '../site.config';
import { promotions, validatePromotions } from '../promotions';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getContent(locale);
validatePromotions(promotions);
---

<section
  id="services"
  class="relative py-20 md:py-32"
  data-promotions
  data-locale={locale}
  data-off-label={t.servicesSection.promotionOff}
  data-until-label={t.servicesSection.promotionUntil}
  data-promotion-label={t.contactSection.promotionLabel}
  data-promotion-price-label={t.contactSection.promotionPriceLabel}
  data-trip-dates-label={t.servicesSection.promotionTripDates}
  data-whatsapp={contact.whatsapp}
  data-whatsapp-interest={t.servicesSection.whatsappInterest}
>
  <div class="container-x">
    <div class="grid grid-cols-12 gap-6 mb-16 md:mb-20">
      <div class="col-span-12 md:col-span-5">
        <p class="eyebrow mb-5">{t.servicesSection.eyebrow}</p>
        <h2 class="text-4xl md:text-6xl">
          {t.servicesSection.heading}<br />
          <span class="italic-display" style="color: var(--color-wine);">{t.servicesSection.headingAccent}</span>
        </h2>
      </div>
      <div class="col-span-12 md:col-span-6 md:col-start-7 self-end">
        <p class="text-base md:text-lg" style="color: var(--color-mute);">
          {t.servicesSection.intro}
        </p>
      </div>
    </div>

    <div data-promotion-banner hidden class="mb-8 p-6 md:p-8" style="background: var(--color-wine); color: var(--color-cream);">
      <p class="eyebrow mb-3" style="color: var(--color-cream);">{t.servicesSection.promotionHeading}</p>
      <ul data-promotion-list class="space-y-2 text-lg"></ul>
      <p class="text-sm mt-3" style="opacity: 0.85;">{t.servicesSection.promotionNote}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-px" style="background: var(--color-line);">
      {t.services.map((s, i) => (
        <article
          class="card group relative overflow-hidden"
          style="border: none; padding: 0;"
          data-service-card
          data-service-id={s.id}
          data-service-name={s.title}
          data-service-price={s.price}
          data-service-suffix={'priceSuffix' in s ? s.priceSuffix : ''}
        >
          <div class="aspect-[16/9] w-full overflow-hidden">
            <img
              src={withBase(s.image)}
              alt=""
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
          </div>

          <div class="p-6 md:p-8">
            <div class="flex items-start justify-between mb-5 gap-4">
              <div class="flex items-baseline gap-3">
                <span class="section-num text-2xl">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="eyebrow" style="color: var(--color-mute);">{s.eyebrow}</span>
              </div>
              <div class="text-right shrink-0">
                <p data-original-price hidden class="text-sm" style="color: var(--color-mute);">
                  <span class="sr-only">{t.servicesSection.originalPrice}: </span><s>${s.price}</s>
                </p>
                <span data-current-price class="text-3xl md:text-4xl" style="font-family: var(--font-display);">${s.price}</span>
                {'priceSuffix' in s && s.priceSuffix && (
                  <span style="color: var(--color-mute); font-size: 0.95rem;">
                    {s.priceSuffix}
                  </span>
                )}
                <p data-conditional-price hidden class="mt-1 text-xs font-medium" style="color: var(--color-wine);">
                  {t.servicesSection.promotionEligibleDates}
                </p>
              </div>
            </div>

            <h3 class="text-3xl md:text-4xl mb-3">{s.title}</h3>

            <p class="mb-2 text-sm" style="color: var(--color-mute);">
              {s.duration} · {s.seats}
            </p>
            <p data-service-offer hidden class="mb-3 text-sm font-medium" style="color: var(--color-wine);"></p>

            <p class="mb-6" style="color: var(--color-ink);">{s.blurb}</p>

            <details class="group/details border-t pt-4" style="border-color: var(--color-line);">
              <summary class="cursor-pointer flex items-center justify-between list-none">
                <span class="eyebrow">{t.servicesSection.details}</span>
                <span
                  class="transition-transform group-open/details:rotate-45 text-xl"
                  style="color: var(--color-mute);"
                >+</span>
              </summary>

              <div class="mt-5 grid sm:grid-cols-2 gap-6 text-sm">
                <div>
                  <p class="eyebrow mb-3">{t.servicesSection.included}</p>
                  <ul class="space-y-1.5" style="color: var(--color-ink);">
                    {s.includes.map((it) => <li>· {it}</li>)}
                  </ul>
                </div>
                <div>
                  <p class="eyebrow mb-3">{t.servicesSection.notIncluded}</p>
                  <ul class="space-y-1.5" style="color: var(--color-mute);">
                    {s.excludes.map((it) => <li>· {it}</li>)}
                  </ul>
                </div>
              </div>

              <a
                href={`https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(
                  `${t.servicesSection.whatsappInterest} ${s.title}.`
                )}`}
                class="btn btn-primary mt-7 text-sm max-w-full whitespace-normal"
                data-service-whatsapp
                target="_blank"
                rel="noopener noreferrer"
              >
                {t.servicesSection.book} {s.title}
                <span aria-hidden="true">→</span>
              </a>
            </details>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
